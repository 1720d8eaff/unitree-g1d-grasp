SELECT_MODE_TIMEOUT = 2.0
SELECT_RETRY_INTERVAL = 10.0
RESTORE_TOTAL_TIMEOUT = 60.0
RPC_TIMEOUT_CODE = 3104

LOWCMD_PREFLIGHT_MAX_AGE = 2.0
SOCKET_ACCEPT_TIMEOUT = 1.0

